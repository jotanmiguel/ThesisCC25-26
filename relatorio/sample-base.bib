@article{sabyasachiCostEffectiveEnergyAwareResource2022,
  title    = {Cost-{{Effective}} and {{Energy-Aware Resource Allocation}} in {{Cloud Data Centers}}},
  author   = {Sabyasachi, Abadhan Saumya and Muppala, Jogesh K.},
  year     = 2022,
